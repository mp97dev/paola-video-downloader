#!/usr/bin/env bash
#
# Bumps the patch component of VERSION and stages it with the commit.
#
# Installed by scripts/install-hooks.sh (sets core.hooksPath to this directory).
# Set SKIP_VERSION_BUMP=1 to commit without bumping, e.g.
#   SKIP_VERSION_BUMP=1 git commit -m "..."
#
# The bump is skipped automatically when:
#   - VERSION is already staged (you are bumping minor/major by hand)
#   - the commit is a merge, rebase, or cherry-pick in progress
#   - the commit is an amend (the version was already bumped for it)
#   - nothing else is staged
set -euo pipefail

if [ "${SKIP_VERSION_BUMP:-0}" = "1" ]; then
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
git_dir="$(git rev-parse --absolute-git-dir)"
version_file="$repo_root/VERSION"

if [ ! -f "$version_file" ]; then
    echo "pre-commit: no VERSION file, skipping version bump" >&2
    exit 0
fi

# Sequenced operations write their own commits; leave the version alone.
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    if [ -e "$git_dir/$marker" ]; then
        exit 0
    fi
done

# `git commit --amend` rewrites a commit that already carries its bump, so
# bumping again would advance the version twice for one logical change. Git
# passes no flag to the hook, so read the invoking command line.
parent_cmd="$(ps -o args= -p "$PPID" 2>/dev/null || true)"
case " $parent_cmd " in
    *" --amend"*)
        exit 0
        ;;
esac

# Nothing staged means git will abort the commit anyway — don't create a
# version-only commit out of thin air.
if git diff --cached --quiet; then
    exit 0
fi

# A manual bump already in the index wins over the automatic one.
if ! git diff --cached --quiet -- "$version_file"; then
    exit 0
fi

current="$(tr -d ' \t\n\r' < "$version_file")"

if ! printf '%s' "$current" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "pre-commit: VERSION ('$current') is not MAJOR.MINOR.PATCH, skipping bump" >&2
    exit 0
fi

IFS='.' read -r major minor patch <<< "$current"
next="${major}.${minor}.$((patch + 1))"

printf '%s\n' "$next" > "$version_file"
git add -- "$version_file"

echo "pre-commit: version $current -> $next"
